msgctxt "cli.project_created"
msgid "Created project:"
msgstr "Projekt erzeugt:"

msgctxt "cli.model_created"
msgid "Created model:"
msgstr "Modell erzeugt:"

msgctxt "cli.dev_started"
msgid "Development server for"
msgstr "Entwicklungsserver für"

msgctxt "cli.dev_stop_hint"
msgid "Stop with Ctrl+C."
msgstr "Beenden mit Strg+C."

msgctxt "cli.dev_stopped"
msgid "Development server stopped."
msgstr "Entwicklungsserver beendet."

msgctxt "cli.dev_test_stopped"
msgid "Development server stopped after the test limit."
msgstr "Entwicklungsserver nach Testfrist beendet."

msgctxt "cli.admin_assets_missing"
msgid "The admin ships inside the Rust binary."
msgstr "Der Admin wird mit dem Rust-Binary ausgeliefert."

msgctxt "cli.user_created"
msgid "Created user:"
msgstr "Benutzer angelegt:"

msgctxt "cli.flag_active"
msgid "Active: yes. An inactive account cannot sign in."
msgstr "Aktiv: ja. Ein inaktives Konto erhält keine Sitzung."

msgctxt "cli.flag_staff_on"
msgid "Staff: yes. This account can open the admin."
msgstr "Staff: ja. Dieses Konto darf die Verwaltung öffnen."

msgctxt "cli.flag_staff_off"
msgid "Staff: no. Without staff the admin stays closed."
msgstr "Staff: nein. Ohne Staff bleibt die Verwaltung geschlossen."

msgctxt "cli.flag_super_on"
msgid "Superuser: yes. This does not replace staff."
msgstr "Superuser: ja. Das ersetzt Staff nicht."

msgctxt "cli.flag_super_off"
msgid "Superuser: no."
msgstr "Superuser: nein."

msgctxt "cli.super_without_staff"
msgid "Note: --superuser without --staff. Model rights apply, but the admin stays closed."
msgstr "Hinweis: --superuser ohne --staff. Die Modellrechte gelten, der Admin-Zugang bleibt zu."

msgctxt "cli.dev_no_migrate"
msgid "fexu dev does not apply migrations and does not write the schema."
msgstr "fexu dev wendet keine Migrationen an und schreibt das Schema nicht."

msgctxt "cli.port_busy"
msgid "The port is already in use. Stop the other process or change server.port. Nothing is migrated."
msgstr "Der Port ist belegt. Beenden Sie den anderen Prozess oder ändern Sie server.port. Es wird nichts migriert."
